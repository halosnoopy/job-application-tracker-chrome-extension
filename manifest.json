{
  "manifest_version": 3,
  "name": "Job Application Tracker",
  "version": "4.0",
  "description": "Track and visualize submitted job applications.",
  "permissions": ["storage", "tabs", "activeTab", "scripting", "identity", "contextMenus"],
  "host_permissions": ["https://www.googleapis.com/*"],
  "oauth2": {
    "client_id": "input your own client id here",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
